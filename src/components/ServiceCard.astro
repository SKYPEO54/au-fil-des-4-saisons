---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  text: string;
  href: string;
  image: ImageMetadata;
}
const { title, text, href, image } = Astro.props;
---

<a href={href} class="card card-hover group block">
  <div class="relative aspect-[4/3] overflow-hidden">
    <Image
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      widths={[400, 640, 800]}
      sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-green-950/70 via-green-950/10 to-transparent"></div>
  </div>
  <div class="p-6 lg:p-7">
    <h3 class="text-xl lg:text-2xl text-cream flex items-center justify-between gap-2">
      {title}
      <span class="shrink-0 w-9 h-9 rounded-full bg-lime/15 text-lime flex items-center justify-center transition-all group-hover:bg-lime group-hover:text-green-900">
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </h3>
    <p class="mt-2 text-sm text-cream/65 leading-relaxed">{text}</p>
  </div>
</a>
