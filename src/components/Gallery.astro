---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  title?: string;
  accent?: string;
}
const { images, title, accent } = Astro.props;
---

<section class="container-x my-20 lg:my-28">
  {title && (
    <div class="max-w-2xl mb-12">
      <span class="eyebrow">Nos réalisations</span>
      <h2 class="mt-4 text-3xl md:text-5xl text-cream">{title}{accent && <> <span class="accent">{accent}</span></>}</h2>
    </div>
  )}
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 *:mb-5">
    {images.map((img, i) => (
      <div class="break-inside-avoid overflow-hidden rounded-3xl group">
        <Image
          src={img}
          alt={`Réalisation Au Fil des 4 Saisons ${i + 1}`}
          class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
          widths={[400, 640, 800]}
          sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</section>
