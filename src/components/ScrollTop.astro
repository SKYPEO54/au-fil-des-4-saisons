---
// Bouton "retour en haut" : pastille verte avec un anneau lime qui se remplit
// en temps réel selon la progression du scroll (vide en haut, complet en bas).
// Autonome : pose ce composant une fois (dans Base.astro), pas de prop.
---

<button
  type="button"
  class="scrolltop"
  aria-label="Revenir en haut de la page"
  data-scrolltop
>
  <svg class="scrolltop__ring" viewBox="0 0 48 48" aria-hidden="true">
    <!-- anneau de fond discret -->
    <circle cx="24" cy="24" r="21" class="scrolltop__track" />
    <!-- anneau de progression (lime) — piloté par stroke-dashoffset -->
    <circle cx="24" cy="24" r="21" class="scrolltop__progress" data-scrolltop-ring />
  </svg>
  <!-- flèche vers le haut au centre -->
  <svg class="scrolltop__arrow" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 19V5M12 5l-6 6M12 5l6 6" />
  </svg>
</button>

<style>
  .scrolltop {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background-color: var(--color-green-900);
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.5);
    cursor: pointer;
    /* caché par défaut, révélé après un peu de scroll */
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      visibility 0.35s ease,
      background-color 0.35s ease;
  }

  .scrolltop.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .scrolltop:hover {
    background-color: var(--color-lime);
  }

  /* le SVG de l'anneau couvre tout le bouton */
  .scrolltop__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* on démarre le tracé en haut (midi) et on tourne dans le sens horaire */
    transform: rotate(-90deg);
  }

  .scrolltop__track {
    fill: none;
    stroke: var(--color-green-600);
    stroke-width: 3;
  }

  .scrolltop__progress {
    fill: none;
    stroke: var(--color-lime);
    stroke-width: 3;
    stroke-linecap: round;
    /* circonférence = 2 × π × 21 ≈ 131.95 ; rempli via dashoffset en JS */
    stroke-dasharray: 131.95;
    stroke-dashoffset: 131.95;
    transition: stroke-dashoffset 0.1s linear;
  }

  .scrolltop__arrow {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--color-lime);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      stroke 0.35s ease,
      transform 0.35s ease;
  }

  .scrolltop:hover .scrolltop__arrow {
    stroke: var(--color-green-900);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolltop,
    .scrolltop__progress,
    .scrolltop__arrow {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-scrolltop]");
  const ring = document.querySelector<SVGCircleElement>("[data-scrolltop-ring]");

  if (btn && ring) {
    const CIRCUMFERENCE = 2 * Math.PI * 21; // r = 21

    let ticking = false;
    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const scrollTop = window.scrollY || doc.scrollTop;
      const max = doc.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(Math.max(scrollTop / max, 0), 1) : 0;

      // remplit l'anneau : offset = circonférence × (1 - progression)
      ring.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - progress));

      // visible dès qu'on a un peu défilé
      btn.classList.toggle("is-visible", scrollTop > 300);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();

    btn.addEventListener("click", () => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
  }
</script>
