---
// Galerie masonry (colonnes CSS, hauteurs variables) + description sous chaque photo.
// Clic sur une image -> lightbox plein écran.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Item {
  image: ImageMetadata;
  legende: string;
}
interface Props {
  eyebrow?: string;
  title?: string;
  accent?: string;
  items: Item[];
}
const { eyebrow, title, accent, items } = Astro.props;
---

<section class="container-x my-16 lg:my-24">
  {(eyebrow || title) && (
    <div class="mb-12 max-w-3xl">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {title && (
        <h2 class="mt-4 text-3xl md:text-4xl lg:text-5xl text-cream">
          {title}{accent && <> <span class="accent text-lime">{accent}</span></>}
        </h2>
      )}
    </div>
  )}
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 [column-fill:balance]">
    {items.map((it) => (
      <figure class="mb-6 break-inside-avoid">
        <button type="button" data-lb-m class="group block w-full overflow-hidden rounded-3xl shadow-xl shadow-black/20 cursor-zoom-in">
          <Image
            src={it.image}
            alt={it.legende}
            class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
            widths={[400, 600, 900]}
            sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw"
            loading="lazy"
          />
        </button>
        <figcaption class="mt-3 text-sm text-cream/70">{it.legende}</figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  // --- Lightbox ---
  let lb: HTMLElement | null = null;
  let lbImg: HTMLImageElement | null = null;
  function ensureLightbox() {
    if (lb) return;
    lb = document.createElement("div");
    lb.className = "fixed inset-0 z-[100] hidden items-center justify-center bg-green-950/92 backdrop-blur-sm p-4 cursor-zoom-out";
    lb.innerHTML =
      '<button type="button" data-lb-close aria-label="Fermer" class="absolute top-5 right-5 w-12 h-12 flex items-center justify-center rounded-full bg-lime text-green-900 hover:bg-lime-bright transition">' +
      '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>' +
      '<figure class="flex flex-col items-center gap-3"><img data-lb-img alt="" class="max-h-[82vh] max-w-[92vw] rounded-2xl shadow-2xl object-contain" /><figcaption data-lb-cap class="text-cream/80 text-sm text-center"></figcaption></figure>';
    document.body.appendChild(lb);
    lbImg = lb.querySelector("[data-lb-img]");
    lb.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === lb || t.closest("[data-lb-close]")) closeLightbox();
    });
  }
  function openLightbox(src: string, alt: string) {
    ensureLightbox();
    if (!lb || !lbImg) return;
    lbImg.src = src; lbImg.alt = alt;
    const cap = lb.querySelector("[data-lb-cap]");
    if (cap) cap.textContent = alt;
    lb.classList.remove("hidden"); lb.classList.add("flex");
    document.body.style.overflow = "hidden";
  }
  function closeLightbox() {
    if (!lb) return;
    lb.classList.add("hidden"); lb.classList.remove("flex");
    document.body.style.overflow = "";
  }
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLightbox(); });
  function largestSrc(img: HTMLImageElement): string {
    const ss = img.getAttribute("srcset");
    if (!ss) return img.currentSrc || img.src;
    let best = img.currentSrc || img.src; let bw = 0;
    ss.split(",").forEach((part) => {
      const [u, w] = part.trim().split(/\s+/);
      const n = parseInt(w);
      if (n >= bw) { bw = n; best = u; }
    });
    return best;
  }
  function initMasonry() {
    document.querySelectorAll("[data-lb-m]").forEach((btn) => {
      const el = btn as HTMLElement;
      if (el.dataset.lbBound) return;
      el.dataset.lbBound = "1";
      el.addEventListener("click", () => {
        const img = el.querySelector("img") as HTMLImageElement | null;
        if (img) openLightbox(largestSrc(img), img.alt);
      });
    });
  }
  initMasonry();
  document.addEventListener("astro:after-swap", initMasonry);
</script>
