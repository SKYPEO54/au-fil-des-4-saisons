---
import { Image } from "astro:assets";
import heroImg from "../assets/accueil/hero.jpg";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Un projet de jardin ou d'<span class=\"accent\">aménagement extérieur</span> ?",
  text = "Parlons-en. Notre équipe vous accompagne de la conception à la réalisation, avec un devis gratuit et sans engagement.",
} = Astro.props;
---

<section class="relative min-h-115 lg:min-h-screen flex overflow-hidden">
  <!-- Photo en fond, plein cadre sur toute la section -->
  <Image
    src={heroImg}
    alt="Aménagement de jardin par Au Fil des 4 Saisons"
    class="absolute inset-0 h-full w-full object-cover"
    widths={[1000, 1600, 2400]}
    sizes="100vw"
    loading="lazy"
  />
  <!-- Voile sombre pour la lisibilité du texte (plus dense à gauche) -->
  <div class="absolute inset-0 bg-linear-to-r from-green-950/85 via-green-950/45 to-green-950/10"></div>

  <!-- Contenu : titre en haut, bouton en bas -->
  <div class="container-x relative z-10 flex flex-col justify-center py-12 lg:py-16 text-cream">
    <div>
      <h2 class="text-5xl md:text-6xl lg:text-7xl max-w-2xl" set:html={title}></h2>
      <p class="mt-10 max-w-lg text-xl text-cream/80 lg:text-2xl">{text}</p>
    </div>
    <div class="mt-10">
      <a href="/contact" class="group inline-flex items-center gap-4 rounded-full bg-lime py-2 pl-7 pr-2 text-green-900 transition-colors duration-300 hover:bg-green-900 hover:text-lime">
        <span class="text-sm font-semibold uppercase tracking-[0.12em]">Demander un devis</span>
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-green-900 text-lime transition-colors duration-300 group-hover:bg-lime group-hover:text-green-900">
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>
