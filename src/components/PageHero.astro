---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  text?: string;
  image: ImageMetadata;
  breadcrumb?: { label: string; href: string }[];
}
const { eyebrow, title, accent, text, image, breadcrumb } = Astro.props;
---

<section class="relative">
  <div class="relative overflow-hidden min-h-[46vh] lg:min-h-[58vh] flex items-end">
    <Image
      src={image}
      alt={title}
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-green-950/85 via-green-950/45 to-green-950/15"></div>

    <div class="container-x relative z-10 pb-12 lg:pb-16 pt-28">
      {breadcrumb && (
        <nav class="mb-5 text-sm text-cream/70 flex flex-wrap gap-1.5" aria-label="Fil d'Ariane">
          {breadcrumb.map((b, i) => (
            <span class="flex items-center gap-1.5">
              {i > 0 && <span aria-hidden="true">/</span>}
              <a href={b.href} class="hover:text-white">{b.label}</a>
            </span>
          ))}
        </nav>
      )}
      {eyebrow && <span class="eyebrow text-lime reveal">{eyebrow}</span>}
      <h1 class="mt-4 text-white text-4xl md:text-5xl lg:text-6xl max-w-4xl reveal" style="animation-delay:.08s">
        {title}{accent && <> <span class="accent text-lime">{accent}</span></>}
      </h1>
      {text && <p class="mt-5 max-w-2xl text-lg text-cream/85 reveal" style="animation-delay:.16s">{text}</p>}
      {Astro.slots.has("actions") && (
        <div class="mt-8 flex flex-wrap gap-4 reveal" style="animation-delay:.24s">
          <slot name="actions" />
        </div>
      )}
    </div>
  </div>
</section>
