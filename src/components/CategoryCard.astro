---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  title: string;
  accent: string;   // mot en serif italique (2e ligne)
  text: string;
  href: string;
  dark?: boolean;    // true = carte émeraude (sur fond lime) ; false = carte lime (sur fond vert)
  image?: ImageMetadata;  // optionnel : photo de fond (avec voile dégradé)
}
const { title, accent, text, href, dark = true, image } = Astro.props;

// Encoche concave dans le coin bas-droite : on perce un cercle transparent
// (rayon 65px, centré à 46px du coin) → le bouton rond (92px) vient s'y nicher,
// collé aux bords, avec un fin anneau côté intérieur.
const mask = "radial-gradient(circle 65px at calc(100% - 46px) calc(100% - 46px), #0000 64px, #000 65px)";
---

<div class="group relative">
  <a
    href={href}
    style={`-webkit-mask:${mask};mask:${mask}`}
    class:list={[
      "relative block overflow-hidden rounded-[1.75rem] p-8 lg:p-9 min-h-[25rem] flex flex-col transition-colors duration-300",
      dark ? "bg-green-800 group-hover:bg-green-700 text-cream" : "bg-lime group-hover:bg-lime-bright text-green-900",
    ]}
  >
    {image ? (
      <Fragment>
        <!-- photo de fond + voile dégradé pour la lisibilité du texte -->
        <Image src={image} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" widths={[400, 640, 800]} sizes="(min-width:1024px) 30vw, 100vw" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-green-950/95 via-green-900/75 to-green-900/45"></div>
      </Fragment>
    ) : (
      <!-- filigrane sparkle (4 branches concaves) -->
      <svg class:list={["pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/4 w-60 h-60", dark ? "text-white/[0.06]" : "text-green-900/[0.06]"]} viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c0 6.6-5.4 12-12 12 6.6 0 12 5.4 12 12 0-6.6 5.4-12 12-12-6.6 0-12-5.4-12-12z"/></svg>
    )}

    <h3 class="relative text-3xl lg:text-[2rem] leading-[1.05]">
      {title}<br /><span class:list={["accent", !dark && "!text-green-700"]}>{accent}</span>
    </h3>
    <p class:list={["relative mt-auto pt-10 text-sm leading-relaxed max-w-[15rem]", dark ? "text-cream/65" : "text-green-900/70"]}>{text}</p>
  </a>

  <!-- bouton rond détaché, niché dans le coin (collé aux bords) -->
  <span
    class:list={[
      "pointer-events-none absolute right-0 bottom-0 w-[92px] h-[92px] rounded-full flex items-center justify-center transition-colors duration-300",
      dark ? "bg-green-800 text-cream group-hover:bg-lime group-hover:text-green-900"
           : "bg-lime text-green-900 group-hover:bg-green-900 group-hover:text-lime",
    ]}
  >
    <svg class="w-7 h-7 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
</div>
