---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollTop from "../components/ScrollTop.astro";
import { company, site } from "../site";
import { entreprise, siteWeb, gerants, auteurs, filAriane, abs, ID_ENTREPRISE, ID_SITE, type Miette } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Fil d'Ariane apres l'accueil (BreadcrumbList). */
  miettes?: Miette[];
  /** Noeuds JSON-LD propres a la page (Service, FAQPage, HowTo...). */
  schemas?: unknown[];
  /** Surcharge du noeud de page (ex. { "@type": "AboutPage" }). Un seul noeud de page par URL. */
  page?: Record<string, unknown>;
  /** Image principale a precharger (LCP) : src, srcset et sizes. */
  lcp?: { src: string; srcset?: string; sizes?: string };
}

const { title, description, image = "/logo.png", miettes = [], schemas = [], page = {}, lcp } = Astro.props;
// Canonique sur l'hote de production, forme a barre finale identique au sitemap.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), site.url + "/").href;
const fullTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;
const dateMaj = /^\d{4}-\d{2}-\d{2}$/.test(site.miseAJour) ? site.miseAJour : undefined;
const toutesMiettes: Miette[] = [{ nom: "Accueil", href: "/" }, ...miettes];

const noeudPage = {
  "@type": "WebPage",
  "@id": canonical + "#page",
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: "fr-FR",
  isPartOf: { "@id": ID_SITE },
  about: { "@id": ID_ENTREPRISE },
  publisher: { "@id": ID_ENTREPRISE },
  author: auteurs,
  ...(dateMaj ? { dateModified: dateMaj } : {}),
  ...(toutesMiettes.length > 1 ? { breadcrumb: { "@id": canonical + "#fil" } } : {}),
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["h1", "[data-reponse]"] },
  ...page,
};

const graphe = {
  "@context": "https://schema.org",
  "@graph": [
    entreprise,
    siteWeb,
    ...gerants,
    noeudPage,
    ...(toutesMiettes.length > 1 ? [filAriane(canonical, toutesMiettes)] : []),
    ...schemas,
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Marque que JS est actif (les éléments [data-reveal] ne sont masqués que si .js est présent) -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={`${site.gerants.map((g) => g.prenom + " " + g.nom).join(", ")}, ${company.name}`} />
    <meta name="geo.region" content="FR-29" />
    <meta name="geo.placename" content={site.ville} />

    <!-- Polices auto-hébergées : préchargées, aucune ressource tierce bloquante -->
    <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lcp && <link rel="preload" as="image" href={lcp.src} imagesrcset={lcp.srcset} imagesizes={lcp.sizes} fetchpriority="high" />}

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé du site pour les assistants IA" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(image)} />

    <script type="application/ld+json" set:html={JSON.stringify(graphe)} />
  </head>
<body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:bg-white focus:px-4 focus:py-2 focus:rounded-full">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer maj={dateMaj} />
    <ScrollTop />

    <!-- Apparition au scroll : ajoute .is-visible quand l'élément [data-reveal] entre dans l'écran -->
    <script>
      const els = document.querySelectorAll("[data-reveal]");
      if (els.length) {
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add("is-visible");
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
          );
          els.forEach((el) => io.observe(el));
        }
      }
    </script>

    <!-- Feuilles décoratives : déclenche un tour sur soi-même (.is-spinning) à l'entrée dans l'écran, une seule fois -->
    <script>
      const leaves = document.querySelectorAll(".leaf-spin");
      if (leaves.length && "IntersectionObserver" in window) {
        const leafIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-spinning");
                leafIo.unobserve(e.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        leaves.forEach((el) => leafIo.observe(el));
      }
    </script>

    <!-- Section épinglée : convertit le scroll vertical en déplacement horizontal (desktop uniquement) -->
    <script>
      const pinWrap = document.querySelector("[data-pin-wrap]");
      const pinTrack = pinWrap?.querySelector("[data-pin-track]");
      if (pinWrap && pinTrack) {
        const mq = window.matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)");
        let ticking = false;
        const update = () => {
          ticking = false;
          // Hors mode horizontal (mobile / reduced-motion) : on efface tout décalage et on empile.
          if (!mq.matches) {
            if (pinTrack.style.transform) pinTrack.style.transform = "";
            return;
          }
          const panels = pinTrack.children.length;
          const distance = pinWrap.offsetHeight - window.innerHeight;
          const scrolled = Math.min(Math.max(-pinWrap.getBoundingClientRect().top, 0), distance);
          const progress = distance > 0 ? scrolled / distance : 0;
          const maxX = (panels - 1) * window.innerWidth;
          pinTrack.style.transform = `translate3d(${(-progress * maxX).toFixed(2)}px,0,0)`;
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        if (mq.addEventListener) mq.addEventListener("change", onScroll);
        update();
      }
    </script>
  </body>
</html>
