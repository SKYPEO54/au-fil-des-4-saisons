---
// Page d'arrivée après l'envoi du formulaire (redirection 303 de api/contact.mjs).
import Base from "../../layouts/Base.astro";
import { company } from "../../site";
---

<Base
  title="Demande envoyée | Au Fil des 4 Saisons"
  description="Votre demande de devis a bien été transmise à Au Fil des 4 Saisons, jardinier paysagiste à Moëlan-sur-Mer. Nous vous répondons dans les plus brefs délais."
  noindex
>
  <section class="container-x min-h-[70vh] flex items-center justify-center pt-32 pb-20 text-center">
    <div class="max-w-xl">
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-lime text-green-900">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7" /></svg>
      </span>
      <h1 class="mt-8 text-4xl md:text-5xl text-cream">Merci, votre demande est <span class="accent text-lime">bien envoyée</span></h1>
      <p class="mt-5 text-lg text-cream/80 leading-relaxed">
        Nous vous répondons dans les plus brefs délais. Pour une question urgente, appelez-nous au
        <a href={company.phoneHref} class="text-lime underline underline-offset-4">{company.phone}</a>.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-lime">Retour à l'accueil</a>
      </div>
    </div>
  </section>
</Base>
